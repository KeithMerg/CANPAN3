 57520                           	psect	config
 57521                           
 57522                           ;Config register CONFIG1 @ 0x300000
 57523                           ;	External Oscillator Selection
 57524                           ;	FEXTOSC = HS, HS (crystal oscillator) above 8 MHz
 57525                           ;	Reset Oscillator Selection
 57526                           ;	RSTOSC = EXTOSC, EXTOSC operating per FEXTOSC bits (device manufacturing default)
 57527   300000                     	org	3145728
 57528   300000  FA                 	db	250
 57529                           
 57530                           ;Config register CONFIG2 @ 0x300001
 57531                           ;	Clock out Enable bit
 57532                           ;	CLKOUTEN = OFF, CLKOUT function is disabled
 57533                           ;	PRLOCKED One-Way Set Enable bit
 57534                           ;	PR1WAY = ON, PRLOCKED bit can be cleared and set only once
 57535                           ;	Clock Switch Enable bit
 57536                           ;	CSWEN = ON, Writing to NOSC and NDIV is allowed
 57537                           ;	JTAG Enable bit
 57538                           ;	JTAGEN = OFF, Disable JTAG Boundary Scan mode, JTAG pins revert to user functions
 57539                           ;	Fail-Safe Clock Monitor Enable bit
 57540                           ;	FCMEN = ON, Fail-Safe Clock Monitor enabled
 57541                           ;	Fail-Safe Clock Monitor -Primary XTAL Enable bit
 57542                           ;	FCMENP = ON, FSCM timer will set FSCMP bit and OSFIF interrupt on Primary XTAL failure
 57543                           ;	Fail-Safe Clock Monitor -Secondary XTAL Enable bit
 57544                           ;	FCMENS = ON, FSCM timer will set FSCMS bit and OSFIF interrupt on Secondary XTAL failu
      +                          re
 57545   300001                     	org	3145729
 57546   300001  EF                 	db	239
 57547                           
 57548                           ;Config register CONFIG3 @ 0x300002
 57549                           ;	MCLR Enable bit
 57550                           ;	MCLRE = EXTMCLR, If LVP = 0, MCLR pin is MCLR; If LVP = 1, RE3 pin function is MCLR
 57551                           ;	Power-up timer selection bits
 57552                           ;	PWRTS = PWRT_64, PWRT set at 64ms
 57553                           ;	Multi-vector enable bit
 57554                           ;	MVECEN = ON, Multi-vector enabled, Vector table used for interrupts
 57555                           ;	IVTLOCK bit One-way set enable bit
 57556                           ;	IVT1WAY = ON, IVTLOCKED bit can be cleared and set only once
 57557                           ;	Low Power BOR Enable bit
 57558                           ;	LPBOREN = OFF, Low-Power BOR disabled
 57559                           ;	Brown-out Reset Enable bits
 57560                           ;	BOREN = SBORDIS, Brown-out Reset enabled , SBOREN bit is ignored
 57561   300002                     	org	3145730
 57562   300002  FD                 	db	253
 57563                           
 57564                           ;Config register CONFIG4 @ 0x300003
 57565                           ;	Brown-out Reset Voltage Selection bits
 57566                           ;	BORV = VBOR_2P7, Brown-out Reset Voltage (VBOR) set to 2.7V
 57567                           ;	ZCD Disable bit
 57568                           ;	ZCD = OFF, ZCD module is disabled. ZCD can be enabled by setting the ZCDSEN bit of ZCD
      +                          CON
 57569                           ;	PPSLOCK bit One-Way Set Enable bit
 57570                           ;	PPS1WAY = ON, PPSLOCKED bit can be cleared and set only once; PPS registers remain loc
      +                          ked after one clear/set cycle
 57571                           ;	Stack Full/Underflow Reset Enable bit
 57572                           ;	STVREN = ON, Stack full/underflow will cause Reset
 57573                           ;	Low Voltage Programming Enable bit
 57574                           ;	LVP = ON, Low voltage programming enabled. MCLR/VPP pin function is MCLR. MCLRE config
      +                          uration bit is ignored
 57575                           ;	Extended Instruction Set Enable bit
 57576                           ;	XINST = OFF, Extended Instruction Set and Indexed Addressing Mode disabled
 57577   300003                     	org	3145731
 57578   300003  FD                 	db	253
 57579                           
 57580                           ;Config register CONFIG5 @ 0x300004
 57581                           ;	WDT Period selection bits
 57582                           ;	WDTCPS = WDTCPS_31, Divider ratio 1:65536; software control of WDTPS
 57583                           ;	WDT operating mode
 57584                           ;	WDTE = OFF, WDT Disabled; SWDTEN is ignored
 57585   300004                     	org	3145732
 57586   300004  9F                 	db	159
 57587                           
 57588                           ;Config register CONFIG6 @ 0x300005
 57589                           ;	WDT Window Select bits
 57590                           ;	WDTCWS = WDTCWS_7, window always open (100%); software control; keyed access not requi
      +                          red
 57591                           ;	WDT input clock selector
 57592                           ;	WDTCCS = SC, Software Control
 57593   300005                     	org	3145733
 57594   300005  FF                 	db	255
 57595                           
 57596                           ;Config register CONFIG7 @ 0x300006
 57597                           ;	Boot Block Size selection bits
 57598                           ;	BBSIZE = BBSIZE_1024, Boot Block size is 1024 words
 57599                           ;	Boot Block enable bit
 57600                           ;	BBEN = ON, Boot block enabled
 57601                           ;	Storage Area Flash enable bit
 57602                           ;	SAFEN = OFF, SAF disabled
